# Git 줄바꿈 설정 — 모든 OS에서 일관성 유지
* text=auto

# 명시적으로 텍스트 파일 지정
*.java text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Windows 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리 파일 (줄바꿈 변환 금지)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary
